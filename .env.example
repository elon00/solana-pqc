# SCSTOBCMinority AI — Testnet-first configuration

NODE_ENV=development

# Solana Testnet
SOLANA_NETWORK=testnet
SOLANA_RPC_URL=https://api.testnet.solana.com
ANCHOR_PROVIDER_URL=https://api.testnet.solana.com

# Backend
API_HOST=0.0.0.0
API_PORT=3001
ALLOWED_ORIGINS=https://elon00.github.io,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
WALLET_AUTH_SECRET=replace-with-at-least-32-random-characters


# x402 v2 / Bazaar payment rail
# The app contracts remain Solana Testnet-first; x402 defaults to Solana Devnet USDC because
# that is a supported x402 SVM test payment rail.
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PUBLIC_BASE_URL=https://scstobcminority-ai.netlify.app
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_ASSET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
X402_PAY_TO=8qhW8ctXX77UNLTY9kx3XoAoH8kstQXPbCghUwqu34es
X402_MAX_TIMEOUT_SECONDS=60

# Frontend
VITE_SOLANA_NETWORK=testnet
VITE_SOLANA_RPC_URL=https://api.testnet.solana.com
VITE_API_BASE_URL=http://localhost:3001

# Program IDs are populated only after verified Testnet deployment.
VITE_QUANTUM_CUSTODY_PROGRAM_ID=
VITE_SPQC_TOKEN_PROGRAM_ID=
QUANTUM_CUSTODY_PROGRAM_ID=
SPQC_TOKEN_PROGRAM_ID=

# Optional server-side model providers.
# Never expose these keys as VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

MODEL_PROVIDER_PRIORITY=openai,anthropic,gemini,local
