{
  "name": "scstobcminority-ai",
  "version": "0.1.0",
  "description": "SCSTOBCMinority AI — quantum-safe Solana research infrastructure and SPQC community-utility token prototype for transparent, rights-respecting human-development programs.",
  "main": "index.js",
  "scripts": {
    "build": "anchor build",
    "test": "npm run branding:check && npm run test:nist && npm run audit:crypto && npm run reality:audit && npm run test:deployment",
    "test:nist": "npx tsx tests/official-nist-vectors.test.ts",
    "audit:crypto": "node scripts/audit-crypto.mjs",
    "reality:universal": "npm run reality:audit",
    "reality:certify": "npm run reality:audit",
    "deploy:mainnet": "node -e \"console.error('Mainnet deployment is disabled until verified Testnet evidence and explicit release approval.'); process.exit(1)\"",
    "initialize:devnet": "node scripts/initialize-devnet.mjs",
    "initialize:mainnet": "node -e \"console.error('Mainnet initialization is disabled until verified Testnet evidence and explicit release approval.'); process.exit(1)\"",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "app:dev": "cd app && npm run dev",
    "app:build": "npm run branding:check && cd app && npm run build",
    "sdk:build": "cd sdk/typescript && npm run build",
    "docs": "typedoc --out docs/api sdk/typescript/src",
    "testnet:backend": "cd backend && npm ci && npm run check && npm test",
    "testnet:frontend": "cd app && npm ci && npm run build",
    "testnet:stack": "docker compose -f docker-compose.testnet.yml up --build",
    "testnet:stack:down": "docker compose -f docker-compose.testnet.yml down --remove-orphans",
    "branding:check": "node scripts/check-branding.mjs",
    "reality:audit": "node scripts/reality-audit.mjs",
    "deploy:testnet": "anchor deploy --provider.cluster testnet",
    "initialize:testnet": "node scripts/initialize-testnet.mjs",
    "test:deployment": "node --test tests/deployment-evidence.test.mjs",
    "copilot:check": "node scripts/check-colosseum.mjs",
    "test:nextgen": "node --test tests/nextgen-integrations.test.mjs"
  },
  "keywords": [
    "solana",
    "blockchain",
    "post-quantum",
    "cryptography",
    "nist",
    "custody",
    "wallet",
    "security"
  ],
  "author": "SCSTOBCMinority AI Team",
  "license": "MIT",
  "dependencies": {
    "@solana/web3.js": "^1.87.6",
    "@noble/post-quantum": "0.7.1",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/mocha": "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "chai": "^4.3.10",
    "eslint": "^8.54.0",
    "mocha": "^10.2.0",
    "prettier": "^3.1.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.1",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.2",
    "tsx": "^4.21.0"
  },
  "overrides": {
    "bn.js": "5.2.5",
    "rpc-websockets": {
      ".": "9.3.9",
      "ws": "8.21.3"
    },
    "jayson": {
      "ws": "8.21.3"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
