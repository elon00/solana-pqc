{
  "version": 2,
  "buildCommand": "cd app && npm ci && npm run build",
  "outputDirectory": "app/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/health",
      "destination": "/api/index.mjs"
    }
  ]
}
