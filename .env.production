# Active public web configuration: TESTNET ONLY
NODE_ENV=production
SOLANA_NETWORK=testnet
SOLANA_RPC_URL=https://api.testnet.solana.com
ANCHOR_PROVIDER_URL=https://api.testnet.solana.com

VITE_SOLANA_NETWORK=testnet
VITE_SOLANA_RPC_URL=https://api.testnet.solana.com

# Set this to the deployed backend origin, e.g. Railway/Render/Vercel backend URL.
# GitHub Pages cannot host the Node backend itself.
VITE_API_BASE_URL=

# Set only after TESTNET_DEPLOYMENT.md records verified on-chain addresses.
VITE_QUANTUM_CUSTODY_PROGRAM_ID=
VITE_SPQC_TOKEN_PROGRAM_ID=

API_HOST=0.0.0.0
API_PORT=3001
ALLOWED_ORIGINS=https://elon00.github.io
RATE_LIMIT_PER_MINUTE=60
